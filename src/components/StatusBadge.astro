---
/**
 * Badge de status "aberto agora".
 *
 * O HTML sai do build OCULTO (atributo hidden) e só aparece quando
 * status-dom.ts calcula o estado real no navegador — a regra da arquitetura
 * é nunca exibir um badge errado: sem JS, o badge simplesmente não existe
 * e as tabelas de horário estáticas respondem pelo conteúdo.
 *
 * Variantes:
 *  - agregado → header ("2 lojas abertas" / "1 loja aberta" / "Fechado agora…")
 *  - unidade  → status de uma loja ("Aberto · fecha às 22h")
 *  - inline   → sem pílula, para linhas de texto (hero, cards compactos)
 *  - grande   → hero das páginas de unidade
 *
 * Estados aplicados pelo JS via data-estado: aberto | breve | fechado.
 * (override usa o tom "fechado" com a mensagem custom do JSON.)
 */
interface Props {
  variante?: 'agregado' | 'unidade' | 'inline' | 'grande';
  /** Obrigatório nas variantes unidade/inline/grande. */
  unidade?: 'galeria-suica' | 'vila-germanica';
  /** true quando o badge senta sobre fundo verde (usa preto-800 → verde-800). */
  sobreVerde?: boolean;
  class?: string;
}

const { variante = 'unidade', unidade, sobreVerde = false, class: className } = Astro.props;

const tipo = variante === 'agregado' ? 'agregado' : 'unidade';
---

<span
  class:list={['status-badge', `status-badge--${variante}`, { 'status-badge--verde': sobreVerde }, className]}
  data-status={tipo}
  data-unidade={tipo === 'unidade' ? unidade : undefined}
  role="status"
  hidden
>
  <span class="status-badge__dot" aria-hidden="true"></span>
  <span data-status-texto></span>
</span>

<style>
  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    padding: 6px 12px;
    border-radius: var(--radius-pill);
    background: var(--preto-800);
    border: 1px solid var(--linha-suave);
    font-family: var(--font-text);
    font-size: var(--fs-sm);
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
    color: var(--status-fechado);
  }

  .status-badge--verde {
    background: var(--verde-800);
  }

  .status-badge__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: currentColor;
    flex-shrink: 0;
  }

  .status-badge[data-estado='aberto'] {
    color: var(--status-aberto);
    border-color: rgba(143, 191, 127, 0.4);
  }

  .status-badge[data-estado='breve'] {
    color: var(--status-breve);
    border-color: rgba(217, 169, 63, 0.4);
  }

  .status-badge[data-estado='fechado'] {
    color: var(--status-fechado);
    border-color: rgba(167, 158, 140, 0.35);
  }

  /* Override (feriado/fechamento excepcional): tom dourado/neutro, nunca vermelho */
  .status-badge[data-estado='override'] {
    color: var(--dourado-400);
    border-color: rgba(176, 141, 62, 0.45);
  }

  .status-badge--grande {
    padding: 10px 18px;
    font-size: 1.0625rem;
  }

  .status-badge--inline {
    background: transparent;
    border: none;
    padding: 0;
    white-space: normal;
  }
</style>
