---
/**
 * Link para o WhatsApp com mensagem pré-preenchida por contexto.
 * Fonte única: whatsapp.json (número + mensagens aprovadas).
 *
 * Variantes:
 *  - botao → visual de CTA secundário com ícone verde (padrão)
 *  - texto → link textual com ícone pequeno
 *
 * data-track preparado para a fase de tracking (evento: click_whatsapp).
 */
import { waLink, whatsapp } from '../content';

interface Props {
  contexto: keyof typeof whatsapp.mensagens;
  /** Origem para o tracking, ex.: "sticky_bar", "footer", "home_cta_final". */
  origem: string;
  variante?: 'botao' | 'texto';
  bloco?: boolean;
  class?: string;
}

const { contexto, origem, variante = 'botao', bloco = false, class: className } = Astro.props;
const href = waLink(contexto);
---

{whatsapp.ativo && (
<a
  href={href}
  target="_blank"
  rel="noopener"
  class:list={['wa', `wa--${variante}`, { 'wa--bloco': bloco }, className]}
  data-track="click_whatsapp"
  data-track-origem={origem}
>
  <svg
    class="wa__icone"
    aria-hidden="true"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M12 3a9 9 0 0 0-7.8 13.5L3 21l4.7-1.2A9 9 0 1 0 12 3Z"></path>
    <path d="M9 9.5c0 3 2.5 5.5 5.5 5.5l1.5-1.5-2-1.5-1 .8a4.2 4.2 0 0 1-2.3-2.3l.8-1-1.5-2L9 9.5Z"></path>
  </svg>
  <slot>Chamar no WhatsApp</slot>
</a>
)}

<style>
  .wa {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-2);
    font-family: var(--font-text);
    font-weight: 600;
    line-height: 1;
  }

  .wa:hover {
    text-decoration: none;
  }

  .wa__icone {
    width: 20px;
    height: 20px;
    color: var(--whatsapp); /* o verde fica só no ícone */
    flex-shrink: 0;
  }

  .wa--botao {
    height: var(--btn-h);
    padding-inline: var(--sp-5);
    border-radius: var(--radius-md);
    border: 1px solid var(--creme-40);
    color: var(--creme-100);
    font-size: var(--fs-label);
    transition:
      border-color var(--dur-fast) ease,
      background var(--dur-fast) ease;
  }

  .wa--botao:hover {
    border-color: var(--creme-100);
    background: rgba(240, 230, 210, 0.06);
  }

  @media (min-width: 1024px) {
    .wa--botao {
      height: var(--btn-h-desktop);
    }
  }

  .wa--texto {
    color: var(--creme-100);
    font-size: var(--fs-sm);
  }

  .wa--texto:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .wa--bloco {
    width: 100%;
  }
</style>
