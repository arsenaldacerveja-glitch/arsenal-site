---
/**
 * Carrossel manual de fotos — deslizável por toque (scroll-snap nativo,
 * funciona sem JS) com setas como aprimoramento (ui.ts). SEM autoplay,
 * conforme direção visual. Fotos servidas de /public/midia/.
 */
interface Foto {
  arquivo: string;
  alt: string;
}

interface Props {
  fotos: Foto[];
  /** Rótulo acessível da região, ex.: "Fotos da régua de degustação". */
  rotulo: string;
  class?: string;
}

const { fotos, rotulo, class: className } = Astro.props;
---

<div class:list={['carrossel', className]} data-carousel role="region" aria-label={rotulo}>
  <div class="carrossel__trilho" data-carousel-track tabindex="0">
    {
      fotos.map((f) => (
        <div class="carrossel__slide">
          <img src={`/midia/${f.arquivo}`} alt={f.alt} loading="lazy" decoding="async" />
        </div>
      ))
    }
  </div>
  {
    fotos.length > 1 && (
      <div class="carrossel__setas">
        <button type="button" data-carousel-prev aria-label="Foto anterior">
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M15 6l-6 6 6 6" />
          </svg>
        </button>
        <button type="button" data-carousel-next aria-label="Próxima foto">
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 6l6 6-6 6" />
          </svg>
        </button>
      </div>
    )
  }
</div>

<style>
  .carrossel__trilho {
    display: flex;
    gap: var(--sp-4);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    border-radius: var(--radius-lg);
  }

  .carrossel__trilho::-webkit-scrollbar {
    display: none;
  }

  .carrossel__trilho:focus-visible {
    outline: 2px solid var(--dourado-400);
    outline-offset: 2px;
  }

  .carrossel__slide {
    flex: 0 0 82%;
    scroll-snap-align: start;
  }

  @media (min-width: 768px) {
    .carrossel__slide {
      flex-basis: 46%;
    }
  }

  @media (min-width: 1024px) {
    .carrossel__slide {
      flex-basis: 32%;
    }
  }

  .carrossel__slide img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }

  .carrossel__setas {
    display: flex;
    gap: var(--sp-3);
    margin-top: var(--sp-4);
  }

  .carrossel__setas button {
    width: var(--touch-min);
    height: var(--touch-min);
    display: grid;
    place-items: center;
    background: transparent;
    border: 1px solid var(--creme-40);
    border-radius: 50%;
    color: var(--creme-100);
    cursor: pointer;
    transition: border-color var(--dur-fast) ease, background var(--dur-fast) ease;
  }

  .carrossel__setas button:hover {
    border-color: var(--creme-100);
    background: rgba(240, 230, 210, 0.06);
  }

  .carrossel__setas svg {
    width: 20px;
    height: 20px;
  }
</style>
