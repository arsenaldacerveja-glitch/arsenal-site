---
/**
 * Mídia do site — foto real ou placeholder elegante.
 *
 * Lê midias.json pelo id:
 *  - "existe": true  → renderiza o arquivo de /public/midia/ (lazy, alt definitivo)
 *  - "existe": false → renderiza o placeholder da direção visual, na PROPORÇÃO
 *    EXATA da mídia final — quando a foto chegar, nada de layout muda.
 *
 * Quando as fotos reais entrarem, migrar para astro:assets (otimização
 * AVIF/WebP automática) — anotado no checklist da Fase F.
 */
import { getMidia } from '../content';

interface Props {
  id: string;
  /** Sobrescreve a proporção do JSON (ex.: recorte 1:1 de uma foto 3:2). */
  proporcao?: '16:9' | '4:5' | '3:2' | '1:1' | '4:3' | '21:9' | '9:16';
  /** Desativa lazy-loading (usar APENAS na mídia LCP do topo da página). */
  prioritaria?: boolean;
  class?: string;
}

const { id, proporcao, prioritaria = false, class: className } = Astro.props;
const m = getMidia(id);

const RATIO: Record<string, string> = {
  '16:9': 'ratio-16x9',
  '4:5': 'ratio-4x5',
  '3:2': 'ratio-3x2',
  '1:1': 'ratio-1x1',
  '4:3': 'ratio-4x3',
  '21:9': 'ratio-21x9',
  '9:16': 'ratio-9x16',
};

const prop = proporcao ?? m.proporcao;
const ratioClass = RATIO[prop] ?? '';
---

{
  m.existe ? (
    <img
      src={`/midia/${m.arquivo}`}
      alt={m.alt}
      loading={prioritaria ? 'eager' : 'lazy'}
      decoding="async"
      class:list={['media', ratioClass, className]}
    />
  ) : (
    <div
      class:list={['media-placeholder', ratioClass, className]}
      role="img"
      aria-label={m.alt}
    >
      <svg
        class="media-placeholder__icone"
        aria-hidden="true"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        {m.tipo === 'video' ? (
          <>
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <path d="m10 9 5 3-5 3V9Z" />
          </>
        ) : m.tipo === 'mapa' ? (
          <>
            <path d="M12 21s-6-5.2-6-10a6 6 0 1 1 12 0c0 4.8-6 10-6 10Z" />
            <circle cx="12" cy="11" r="2" />
          </>
        ) : (
          <>
            <rect x="3" y="6" width="18" height="13" rx="2" />
            <path d="M8 6l1.5-2h5L16 6" />
            <circle cx="12" cy="12.5" r="3.5" />
          </>
        )}
      </svg>
      <span class="media-placeholder__arquivo">{m.arquivo} · {prop}</span>
      <span class="media-placeholder__info">{m.descricao}</span>
    </div>
  )
}

<style>
  .media {
    width: 100%;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }

  .media-placeholder__icone {
    width: 32px;
    height: 32px;
    color: var(--creme-40);
    margin-inline: auto;
  }
</style>
