---
/**
 * HOME — Fase D.
 * Estrutura: wireframe-home.md v1.1 · Copy: textos-finais.md (aprovados).
 * Sequência de fundos: preto → preto → VERDE (régua, produto herói) → preto →
 * preto → preto → VERDE (Monte Verde) → preto → preto → VERDE (CTA final).
 * Regra vinculante: 1 CTA dourado por viewport; régua com tratamento de
 * lançamento de produto (adendo UX aprovado).
 * Tracking: apenas atributos data-track/data-observe (track.ts é fase própria).
 */
import Base from '../layouts/Base.astro';
import SectionHeader from '../components/SectionHeader.astro';
import StatusBadge from '../components/StatusBadge.astro';
import CTAButton from '../components/CTAButton.astro';
import WhatsAppLink from '../components/WhatsAppLink.astro';
import Media from '../components/Media.astro';
import UnitCard from '../components/UnitCard.astro';
import NoticeBar from '../components/NoticeBar.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import { site, unidades, kits, mapsHref } from '../content';

/** Mini-FAQ da Home — copy aprovada específica desta página (textos-finais.md). */
const miniFaq = [
  {
    id: 'home-faq-regua',
    pergunta: 'Como funciona a régua de degustação?',
    resposta:
      'Em cada loja há 6 estilos de chopp engatados. Você escolhe 4 e recebe a régua com 4 taças de 200 ml, por R$ 60. Pode dividir no casal.',
    link: { label: 'Ver detalhes →', href: '/degustacao' },
  },
  {
    id: 'home-faq-reserva',
    pergunta: 'Precisa reservar a degustação?',
    resposta: 'Não — a régua é por ordem de chegada, conforme o funcionamento das lojas. É só chegar.',
  },
  {
    id: 'home-faq-online',
    pergunta: 'Tem venda online?',
    resposta:
      'Por enquanto, não. Kits e rótulos são vendidos somente nas lojas físicas, em Monte Verde.',
  },
  {
    id: 'home-faq-unidade',
    pergunta: 'Qual unidade escolher?',
    resposta:
      'Galeria Suíça para degustação, porções e experiência com calma; Vila Germânica para kits, presentes e uma forte curadoria de cervejas mineiras. A régua existe nas duas.',
    link: { label: 'Comparar unidades →', href: '/unidades' },
  },
  {
    id: 'home-faq-kit-online',
    pergunta: 'O kit de R$ 39,90 é vendido online?',
    resposta:
      'Não — como todos os kits, ele é vendido somente nas lojas físicas. A composição varia conforme a disponibilidade do dia.',
  },
];

/** Mídias dos 4 cards de Kits e Cervejas (ordem do wireframe). */
const midiasKits = [
  'foto-kit-presente-01',
  'foto-prateleira-mineiras',
  'foto-torneiras-chopp',
  'foto-rotulos-especiais',
];
---

<Base
  title="Arsenal da Cerveja | Degustação, Kits e Cervejas Especiais em Monte Verde"
  description={site.descricaoSEO}
  path="/"
>
  <!-- 1 · HERO — apresentar (cinematográfico: foto full-bleed + gradiente) -->
  <section class="hero">
    <Media id="hero-regua-fallback" prioritaria class="hero__foto" />
    <div class="hero__veu" aria-hidden="true"></div>
    <div class="container hero__conteudo">
      <p class="hero__eyebrow">Empório de cervejas especiais · Monte Verde, MG</p>
      <h1>{site.headline}</h1>
      <ul class="hero__pilares" role="list">
        <li>
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3h8l-.8 10a3.2 3.2 0 0 1-6.4 0L8 3ZM12 16.5V21M9 21h6"></path></svg>
          <span>Régua de degustação — 4 estilos por R$ 60, sem reserva</span>
        </li>
        <li>
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 8h14l-1.2 12a1.8 1.8 0 0 1-1.8 1.6H8a1.8 1.8 0 0 1-1.8-1.6L5 8Z"></path><path d="M8.5 8V6.2A3.5 3.5 0 0 1 12 2.7a3.5 3.5 0 0 1 3.5 3.5V8"></path></svg>
          <span>Kits e presentes prontos para levar</span>
        </li>
        <li>
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10 3h4v3.2c0 1 .4 1.8 1 2.6.8 1 1.5 2.2 1.5 3.7V19a2 2 0 0 1-2 2h-5a2 2 0 0 1-2-2v-6.5c0-1.5.7-2.7 1.5-3.7.6-.8 1-1.6 1-2.6V3Z"></path></svg>
          <span>+250 rótulos e 6 chopps engatados por loja</span>
        </li>
      </ul>
      <div class="hero__ctas">
        <CTAButton
          href="/degustacao"
          variante="primario"
          bloco
          dataTrack="click_degustacao"
          dataOrigem="hero"
        >
          Fazer degustação
        </CTAButton>
        <CTAButton href="/unidades" variante="secundario" bloco dataTrack="click_unidades" dataOrigem="hero">
          Ver unidades
        </CTAButton>
      </div>
      <p class="hero__status">
        {
          unidades.map((u) => (
            <span class="hero__status-item">
              {u.nome}: <StatusBadge variante="inline" unidade={u.id} />
            </span>
          ))
        }
      </p>
    </div>
  </section>

  <!-- 2 · STATUS DAS LOJAS — orientar a visita -->
  <section class="section status">
    <div class="container status__in">
      <SectionHeader titulo="Estamos abertos?" />
      <div class="status__grid">
        <UnitCard unidade="galeria-suica" variante="mini" origem="status_bar" />
        <UnitCard unidade="vila-germanica" variante="mini" origem="status_bar" />
      </div>
    </div>
  </section>

  <!-- 3 · RÉGUA — momento-produto (foto full-bleed + specs em números grandes) -->
  <section class="section--verde regua" data-observe="view_regua">
    <Media id="foto-regua-completa" class="regua__fundo" />
    <div class="regua__veu" aria-hidden="true"></div>
    <div class="container regua__conteudo">
      <h2 class="regua__titulo">O brinde mais bonito de Monte Verde</h2>
      <p class="regua__sub">Quatro taças coloridas para provar, comparar e brindar a dois.</p>
      <ul class="regua__specs" role="list">
        <li><strong>6</strong><span>estilos engatados por loja</span></li>
        <li><strong>4</strong><span>você escolhe</span></li>
        <li><strong>200&nbsp;ml</strong><span>em cada taça</span></li>
        <li><strong>R$&nbsp;60</strong><span>pode dividir no casal</span></li>
      </ul>
      <p class="regua__nota">
        Sem reserva — por ordem de chegada, nas duas lojas. Os estilos variam conforme o dia.
      </p>
      <CTAButton
        href="/degustacao"
        variante="primario"
        dataTrack="click_degustacao"
        dataOrigem="home_regua"
      >
        Fazer degustação
      </CTAButton>
    </div>
  </section>

  <!-- 4 · UNIDADES — orientar a visita -->
  <section class="section">
    <div class="container">
      <SectionHeader titulo="Duas lojas, dois jeitos de viver o Arsenal" />
      <div class="unidades__grid">
        <UnitCard unidade="galeria-suica" origem="home_unidades" />
        <UnitCard unidade="vila-germanica" origem="home_unidades" />
      </div>
      <p class="unidades__comparar">
        Não sabe qual escolher? <a href="/unidades">Compare as unidades →</a>
      </p>
    </div>
  </section>

  <!-- 5 · KITS E CERVEJAS — criar desejo -->
  <section class="section kits">
    <div class="container">
      <SectionHeader
        titulo="Kits, presentes e rótulos escolhidos a dedo"
        subtitulo="Curadoria de cervejas especiais — com orgulho das mineiras."
      />
      <NoticeBar
        texto="Vendemos somente nas lojas físicas — a seleção varia conforme o dia."
        class="kits__aviso"
      />
      <div class="kits__destaque">
        <p class="kits__destaque-titulo">Kit Arsenal a partir de R$ 39,90</p>
        <p class="kits__destaque-texto">
          Disponível somente nas lojas físicas. A composição pode variar conforme
          disponibilidade.
        </p>
      </div>
      <ul class="kits__grid" role="list">
        {
          kits.cardsHome.map((card, i) => (
            <li class="kits__card">
              <Media id={midiasKits[i]} proporcao="1:1" />
              <p class="kits__card-titulo">{card.titulo}</p>
              <p class="kits__card-texto">{card.texto}</p>
            </li>
          ))
        }
      </ul>
      <CTAButton href="/cervejas-e-kits" variante="secundario" dataTrack="click_kits" dataOrigem="home_kits">
        Ver kits e cervejas
      </CTAButton>
    </div>
  </section>

  <!-- 6 · EXPERIÊNCIAS COMPLEMENTARES — explicar -->
  <section class="section exp">
    <div class="container">
      <SectionHeader titulo="Para ir além da régua" />
      <div class="exp__grid">
        <article class="exp__card">
          <Media id="foto-smart-tap" proporcao="1:1" compacta class="exp__foto" />
          <div class="exp__corpo">
            <h3>Smart Tap</h3>
            <p>
              Conheça também a Smart Tap, uma experiência complementar do universo Arsenal para
              quem quer praticidade, tecnologia e bebida na medida certa em pontos selecionados
              de Monte Verde.
            </p>
            <a href="/degustacao">Saiba mais na página de degustação →</a>
          </div>
        </article>
        <article class="exp__card">
          <Media id="foto-atendimento-consultivo" proporcao="1:1" compacta class="exp__foto" />
          <div class="exp__corpo">
            <h3>Não sabe por onde começar?</h3>
            <p>
              Nossa equipe apresenta os estilos, entende seu gosto e monta a régua com você. É
              assim que muita gente descobre o primeiro estilo favorito.
            </p>
            <a href="/degustacao" data-track="click_degustacao" data-track-origem="home_experiencias">
              Fazer degustação →
            </a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- 7 · MONTE VERDE — interlúdio edge-to-edge + faixa do mapa -->
  <section class="section--verde mv">
    <div class="mv__interlude">
      <Media id="foto-monte-verde-avenida" class="mv__foto" />
      <div class="mv__veu" aria-hidden="true"></div>
      <div class="container mv__frase">
        <h2>No coração de Monte Verde</h2>
        <p>
          As duas lojas ficam na avenida principal, no caminho de quem passeia por Monte
          Verde. Escolha a unidade, veja o status ao vivo e venha sem pressa. A régua, os
          chopps e os kits esperam por você.
        </p>
      </div>
    </div>
    <div class="container mv__faixa">
      <div class="mv__mapa">
        <Media id="mapa-estatico-unidades" />
      </div>
      <div class="mv__acoes">
        {
          unidades.map((u) => (
            <a
              class="mv__maps"
              href={mapsHref(u)}
              target="_blank"
              rel="noopener"
              data-track="click_maps"
              data-track-origem="home_mapa"
              data-track-unidade={u.id}
            >
              Abrir no Google Maps — {u.nome}
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 8 · SOBRE O ARSENAL — apresentar (confiança, sem CTA) -->
  <section class="section sobre">
    <div class="container sobre__grid">
      <div>
        <SectionHeader titulo="Um arsenal de cervejas especiais na serra" />
        <p class="sobre__texto">
          Desde 2013, o Arsenal da Cerveja serve Monte Verde com a vontade de atender bem quem
          leva cerveja a sério — e quem está só começando. Hoje são duas casas na avenida
          principal, uma curadoria que privilegia as cervejarias mineiras e um atendimento que
          gosta de conversar antes de servir.
        </p>
      </div>
      <Media id="foto-equipe" class="sobre__foto" />
    </div>
  </section>

  <!-- 9 · MINI-FAQ — reduzir dúvidas -->
  <section class="section" data-observe="scroll_faq">
    <div class="container faq-home">
      <SectionHeader
        titulo="Tudo o que você precisa saber antes de vir"
        subtitulo="As respostas que mais ajudam a planejar sua visita."
      />
      <FAQAccordion itens={miniFaq} />
      <p class="faq-home__mais">
        <a href="/perguntas-frequentes">Ver todas as perguntas →</a>
      </p>
    </div>
  </section>

  <!-- 10 · CTA FINAL — orientar a visita -->
  <section class="section section--verde final">
    <div class="container final__in">
      <SectionHeader
        titulo="Já sabe qual experiência combina com você?"
        subtitulo="A régua, um kit para presentear ou só uma boa conversa sobre cerveja — te esperamos em Monte Verde."
        centro
      />
      <div class="final__ctas">
        <CTAButton href="/unidades" variante="secundario" bloco dataTrack="click_unidades" dataOrigem="home_cta_final">
          Ver unidades
        </CTAButton>
        <CTAButton
          href="/degustacao"
          variante="primario"
          bloco
          dataTrack="click_degustacao"
          dataOrigem="home_cta_final"
        >
          Fazer degustação
        </CTAButton>
        <WhatsAppLink contexto="geral" origem="home_cta_final" bloco />
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- 1 · Hero (cinematográfico) ---------- */
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 88svh;
    overflow: hidden;
  }

  .hero :global(.hero__foto) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0;
    aspect-ratio: auto;
  }

  .hero__veu {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(23, 19, 16, 0.6) 0%,
      rgba(23, 19, 16, 0.15) 42%,
      rgba(23, 19, 16, 0.55) 70%,
      rgba(23, 19, 16, 0.95) 100%
    );
  }

  /* Mobile: empilhado (art direction) — foto INTEIRA em cima, sem corte,
     conteúdo em bloco sólido embaixo. Nada de texto sobre foto recortada. */
  @media (max-width: 1023px) {
    .hero {
      display: block;
      min-height: auto;
    }

    .hero :global(.hero__foto) {
      position: relative;
      inset: auto;
      width: 100%;
      height: auto;
      aspect-ratio: 4 / 3;
    }

    .hero__veu {
      position: absolute;
      inset: 0 0 auto 0;
      aspect-ratio: 4 / 3;
      background: linear-gradient(
        180deg,
        rgba(23, 19, 16, 0.45) 0%,
        rgba(23, 19, 16, 0) 35%,
        rgba(23, 19, 16, 0) 62%,
        rgba(23, 19, 16, 1) 100%
      );
    }

    .hero__conteudo {
      padding-block: var(--sp-4) var(--sp-7);
    }

    .hero h1,
    .hero__sub,
    .hero__eyebrow,
    .hero__pilares li {
      text-shadow: none;
    }
  }

  .hero__conteudo {
    position: relative;
    padding-block: var(--sp-8) var(--sp-7);
    max-width: none;
  }

  .hero h1 {
    font-size: var(--fs-display-1);
    line-height: var(--lh-display);
    margin-bottom: var(--sp-4);
    max-width: 16ch;
    text-shadow: 0 2px 24px rgba(23, 19, 16, 0.5);
  }

  .hero__eyebrow {
    font-size: var(--fs-sm);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--dourado-400);
    margin-bottom: var(--sp-3);
    text-shadow: 0 1px 12px rgba(23, 19, 16, 0.7);
  }

  .hero__pilares {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--sp-3);
    margin-bottom: var(--sp-6);
  }

  .hero__pilares li {
    display: flex;
    align-items: flex-start;
    gap: var(--sp-3);
    color: var(--creme-100);
    font-weight: 600;
    font-size: var(--fs-body);
    text-shadow: 0 1px 14px rgba(23, 19, 16, 0.7);
  }

  .hero__pilares svg {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    color: var(--dourado-400);
    margin-top: 3px;
  }

  .hero__ctas {
    display: grid;
    gap: var(--sp-3);
    margin-bottom: var(--sp-4);
    max-width: 420px;
  }

  .hero__status {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-4);
    font-size: var(--fs-sm);
    color: var(--creme-70);
  }

  .hero__status-item {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
  }

  @media (min-width: 1024px) {
    .hero {
      min-height: 92vh;
    }

    .hero__ctas {
      grid-template-columns: auto auto;
      justify-content: start;
      max-width: none;
    }
  }

  /* ---------- 2 · Status ---------- */
  .status {
    padding-top: 0;
  }

  .status__in {
    display: grid;
    gap: var(--sp-4);
  }

  .status__in :global(.sec-head) {
    margin-bottom: 0;
  }

  .status__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sp-3);
  }

  @media (min-width: 1024px) {
    /* Equilíbrio desktop: título à esquerda, cards ocupando a direita */
    .status__in {
      grid-template-columns: 4fr 8fr;
      align-items: center;
      gap: var(--sp-6);
    }

    .status__grid {
      gap: var(--sp-4);
    }
  }

  /* ---------- 3 · Régua (momento-produto, estilo lançamento) ---------- */
  .regua {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    min-height: 92svh;
    padding-block: var(--section-y-hero);
  }

  .regua :global(.regua__fundo) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0;
    aspect-ratio: auto;
  }

  .regua__veu {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(18, 41, 31, 0.92) 0%,
      rgba(18, 41, 31, 0.45) 45%,
      rgba(18, 41, 31, 0.94) 100%
    );
  }

  .regua__conteudo {
    position: relative;
    display: grid;
    justify-items: center;
    text-align: center;
  }

  .regua__titulo {
    font-size: clamp(2rem, 1.5rem + 2.2vw, 3rem);
    max-width: 18ch;
    margin-bottom: var(--sp-3);
    text-shadow: 0 2px 24px rgba(18, 41, 31, 0.6);
  }

  .regua__sub {
    color: var(--creme-100);
    margin-bottom: var(--sp-7);
    text-shadow: 0 1px 16px rgba(18, 41, 31, 0.6);
  }

  .regua__specs {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--sp-6) var(--sp-7);
    margin-bottom: var(--sp-6);
  }

  /* Mobile: specs em grade 2×2, sem quebras irregulares */
  @media (max-width: 767px) {
    .regua__specs {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--sp-6) var(--sp-4);
      width: 100%;
      max-width: 400px;
    }
  }

  /* Mobile: régua também empilhada — foto quadrada inteira + conteúdo no verde */
  @media (max-width: 1023px) {
    .regua {
      display: block;
      min-height: auto;
      padding-block: 0 var(--sp-7);
    }

    .regua :global(.regua__fundo) {
      position: relative;
      inset: auto;
      width: 100%;
      height: auto;
      aspect-ratio: 1 / 1;
    }

    .regua__veu {
      display: none;
    }

    .regua__conteudo {
      padding-top: var(--sp-6);
    }

    .regua__titulo,
    .regua__sub,
    .regua__specs strong {
      text-shadow: none;
    }
  }

  .regua__specs li {
    display: grid;
    justify-items: center;
    gap: var(--sp-1);
  }

  .regua__specs strong {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.25rem, 1.8rem + 2vw, 3.25rem);
    line-height: 1;
    color: var(--dourado-400);
    text-shadow: 0 2px 20px rgba(18, 41, 31, 0.7);
  }

  .regua__specs span {
    font-size: var(--fs-sm);
    color: var(--creme-100);
    max-width: 14ch;
    text-align: center;
  }

  .regua__nota {
    font-size: var(--fs-sm);
    color: var(--creme-70);
    margin-bottom: var(--sp-6);
    max-width: 52ch;
  }

  /* ---------- 4 · Unidades ---------- */
  .unidades__grid {
    display: grid;
    gap: var(--sp-5);
  }

  @media (min-width: 768px) {
    .unidades__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .unidades__comparar {
    margin-top: var(--sp-5);
    font-size: var(--fs-sm);
    color: var(--creme-70);
  }

  /* ---------- 5 · Kits ---------- */
  .kits__aviso {
    margin-bottom: var(--sp-5);
  }

  .kits__destaque {
    border: var(--border-dourada);
    border-top-width: 2px;
    border-radius: var(--radius-lg);
    background: var(--preto-800);
    padding: var(--sp-5);
    margin-bottom: var(--sp-5);
    display: grid;
    gap: var(--sp-2);
  }

  .kits__destaque-titulo {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 600;
    color: var(--dourado-400);
  }

  .kits__destaque-texto {
    font-size: var(--fs-sm);
    color: var(--creme-70);
  }

  .kits__grid {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sp-4);
